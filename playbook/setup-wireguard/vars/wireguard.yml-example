---
# WireGuard interface name
wg_interface: wg0

# WireGuard listen port on the server
wg_port: 51820

# WireGuard tunnel subnet (must not overlap with Azure VNet subnets)
wg_subnet: "10.10.0.0/24"

# WireGuard IP assigned to the server inside the tunnel
wg_server_wg_ip: "10.10.0.1"

# WireGuard IP assigned to the joining peer inside the tunnel
# Override via -e wg_peer_wg_ip=10.10.0.x when running join-peer.yml
# When wg_peer_wg_ip_auto is true, peers are auto-assigned from position in
# wireguard_peers group: first peer -> 10.10.0.2, second -> 10.10.0.3, ...
wg_peer_wg_ip: "10.10.0.2"
wg_peer_wg_ip_auto: true

# Public-facing NIC name on the server (used for iptables NAT rules)
# On Azure Ubuntu 24.04 this is typically eth0
wg_server_public_nic: eth0

# Directory where WireGuard keys and config are stored
wg_config_dir: /etc/wireguard

# PersistentKeepalive for peer (seconds); important for NAT traversal across regions
wg_keepalive: 25
